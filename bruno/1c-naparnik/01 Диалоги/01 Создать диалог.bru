meta {
  name: 01. Создать диалог
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/public/v1/conversations
  body: json
  auth: inherit
}

body:json {
  {
    "ui_language": "ru",
    "programming_language": "1c",
    "script_language": "ru",
    "title": null
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.uuid) {
    bru.setVar("conversationUuid", res.body.uuid);
  }
}

tests {
  test("200 OK и uuid диалога", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().uuid).to.be.a("string");
  });
}

docs {
  POST /public/v1/conversations

  Создаёт диалог. Вызывается перед отправкой первого сообщения.
  Ответ: { uuid, create_time }. uuid автоматически сохраняется
  в переменную conversationUuid для последующих запросов.

  ui_language: "ru" | "en" (по умолчанию "ru")
  programming_language: "1c" | "java" | ... (по умолчанию "1c")
  script_language: язык комментариев к коду, "ru" | "en"
  title: опционально, null — без названия
}
